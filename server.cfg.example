; Dedicated server config. Copy to server.cfg (next to the server binary, or the project
; root when running from source) or pass --config path. CLI args --port / --max-players win.
[server]
port=7777
max_players=6
name="Sunny Acres #1"

; Optional match tuning: any MatchRules property (data/match_rules.gd) can be overridden here.
[match]
; rules="res://data/match_rules.tres"
; min_players=3
; countdown_s=10
