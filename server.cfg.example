; Dedicated server config. Copy to server.cfg (next to the server binary, or the project
; root when running from source) or pass --config path. CLI args --port / --max-players /
; --password win; --no-lan stops the LAN announcements (the server browser's LAN list).
[server]
port=7777
max_players=6
; shown in the server browser and the lobby
name="Sunny Acres #1"
; "" = anyone may join; otherwise players type it when they join
password=""

; Optional match tuning: any MatchRules property (data/match_rules.gd) can be overridden here.
[match]
; rules="res://data/match_rules.tres"
; min_players=3
; countdown_s=10
; The teams' seats: the most supervisors (1 to 3) and rats (1 to 6) in a match. Fewer players are
; split in the same proportion; players past the seats spectate.
; max_supervisors=2
; max_rats=4
; AI bots (M10): fill each match up to this many players at role assignment (2 or more, never past
; the seats: max_supervisors + max_rats fills every seat). 0 = no bots. Humans always get their slots
; first; with bots on, one human can start a match.
; bot_fill_to=6
; 0 easy, 1 normal, 2 hard
; bot_difficulty=1
